{
  "schema_version": 1,
  "models": {
    "analysis": {
      "provider": "openai_chat",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "response_format": "json_object",
      "token_parameter": "max_tokens",
      "max_output_tokens": 32768,
      "timeout_seconds": 1800,
      "max_retries": 1,
      "stream": true,
      "reasoning_effort": "high",
      "max_prompt_characters": 180000
    },
    "review": {
      "provider": "openai_chat",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "response_format": "json_object",
      "token_parameter": "max_tokens",
      "max_output_tokens": 12288,
      "timeout_seconds": 1800,
      "max_retries": 1,
      "stream": true,
      "reasoning_effort": "low",
      "max_prompt_characters": 180000
    },
    "repair": {
      "provider": "openai_chat",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "response_format": "json_object",
      "token_parameter": "max_tokens",
      "max_output_tokens": 32768,
      "timeout_seconds": 1800,
      "max_retries": 1,
      "stream": true,
      "reasoning_effort": "high",
      "max_prompt_characters": 180000
    }
  },
  "budget": {
    "max_requests": 24,
    "max_output_tokens": 393216,
    "max_reported_tokens": 600000
  },
  "batch": {
    "workers": 1,
    "max_repairs": 2,
    "no_review": false,
    "vision_timeout": 2100,
    "render_timeout": 2400,
    "api_workers": 2
  },
  "render": {
    "max_edge": 1600,
    "samples": 128,
    "device": "AUTO",
    "appearance_policy": "photo_reconstruction",
    "tone_match": "reference"
  },
  "pipeline": {
    "analysis_mode": "staged",
    "repair_mode": "typed",
    "validation_retries": 1,
    "staged": {
      "planner_timeout": 1800,
      "detail_timeout": 1200,
      "detail_workers": 2,
      "max_groups": 8,
      "max_parts_per_group": 60,
      "validation_retries": 1,
      "planner_effort": "high",
      "detail_effort": "high"
    },
    "repair_stagnation_patience": 2
  }
}
